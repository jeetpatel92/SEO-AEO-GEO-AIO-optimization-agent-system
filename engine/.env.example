# Claude (or run `ant auth login` once; the SDK picks the profile up)
ANTHROPIC_API_KEY=

# Which site profile to run, and where state lives (use a persistent volume in production)
SAGO_SITE=sites/example.json
SAGO_DATA=/data

# WordPress: a dedicated administrator user with an Application Password (Users > Profile > Application Passwords)
WP_USER=
WP_APP_PASSWORD=

# PageSpeed Insights API key (Google Cloud console, PageSpeed Insights API)
PSI_API_KEY=

# Search Console: service account JSON; add its email as a user on the property
GSC_SERVICE_ACCOUNT_FILE=

# Notifications (optional; without them everything is still in the events table)
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: bearer token for GET /status
SAGO_STATUS_TOKEN=
